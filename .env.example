# Supabase project (Settings -> API). Both values are public: the anon/publishable
# key is safe in the browser because Row Level Security enforces access.
# NEXT_PUBLIC_* values are inlined at build time, so set them before `next build`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Public origin of the app, used for email confirmation links.
# Falls back to the request origin when empty. Production: https://mexuzsystem.com
NEXT_PUBLIC_SITE_URL=
# The "דברו איתנו" button on the landing page (LND-12): the public link of a
# Mexuz lead form, built in the system. Empty: the button is not shown.
NEXT_PUBLIC_CONTACT_FORM_URL=
# LANDING_BUSINESS_TYPE_FIELD_KEY: server only. The key of the lead select field "סוג העסק" on the landing contact form
# (owner (343) ב); unset = the business type goes into the inquiry's message.
LANDING_BUSINESS_TYPE_FIELD_KEY=

# Server only, secret. Supabase -> Settings -> API -> service_role / secret key.
# Used only by the server paths listed in CLAUDE.md, hard rule 5, and in the
# eslint allow-list (a new use is the owner's decision). None acts for a signed-in
# user, except the server's write of a quote's PDF (QUO-06, approved by the owner):
# - the lead intake (/api/forms/*, /api/in/*): public.intake_submit() and a form's
#   public display settings;
# - the push dispatcher (/api/push/dispatch) and the night file cleanup
#   (/api/files/cleanup), both woken by the database with a shared secret;
# - the background job worker (/api/jobs/run, OPS-04), woken by the database with
#   the same secret: public.claim_jobs(), finish_job(), job_message_may_send() only;
# - the Meta Lead Ads webhook (/api/meta/leads, CAP-11) after its signature check, and its
#   sweep (/api/meta/leads/sweep, the same shared secret): public.meta_lead_receive(),
#   meta_lead_claim(), meta_lead_finish() only;
# - "test connection" of a Meta page with its stored token (INT-01, settings > integrations), after
#   the owner's or admin's session was checked: public.integration_test_claim(),
#   integration_test_finish() only;
# - the sign-in lockout (USR-13, the sign-in action): public.login_guard() only, with keyed
#   hashes of the typed address and the sender (INTAKE_IP_HASH_SECRET); without the key the
#   lockout is off and sign-in works as before;
# - the public secret-link pages, each calling only its own definer functions:
#   the calendar feed (/api/calendar-feed/<token>.ics), the booking page and the
#   customer's booking link (/f/book/...), the quote page and its accept/decline
#   (/f/quote/<token>), the quote's PDF download (/api/forms/quote/<token>/pdf),
#   the order page and its confirmation (/f/order/<token>), the QR scan
#   (/f/q/<token>), the site widget (/f/w/..., /f/widget/...), the digital
#   business card (/f/card/<token>), the subprocessors page (/legal/subprocessors),
#   and, for the preview bots of src/lib/preview-bots.ts only, those customer pages'
#   link previews (public.link_preview_public(): display name and logo, nothing counted);
# - the server's write of a quote's PDF (public.quote_pdf_store()), only after the
#   signed-in user's own session passed public.quote_pdf_allowed() or
#   public.quote_pdf_remake_allowed().
# Without it, forms, webhooks and those pages answer 503 or "not found".
# Never prefix it with NEXT_PUBLIC_, never use it for a signed-in user's request.
SUPABASE_SERVICE_ROLE_KEY=

# FXS-12 (owner (281) א): the project's SECRET key (Supabase -> Settings -> API Keys -> Secret keys, it starts with
# sb_secret_; a legacy service_role JWT is not accepted here). Server only, secret, never NEXT_PUBLIC_. Set by the owner in
# Vercel. Read only by src/lib/supabase/auth-forwarding-server.ts (lint refuses the name elsewhere), used ONLY for the
# sign-in, sign-up and password-reset calls to Supabase Auth, so they can carry the user's address in sb-forwarded-for
# and Auth rate-limits each user instead of all of Vercel together. Needs "IP Address Forwarding" switched on in
# Supabase -> Authentication -> Rate Limits. Empty: those calls run as before, without the forwarded address.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile on the sign-in, sign-up and forgot-password forms (owner (275) א). Cloudflare dashboard -> Turnstile ->
# the widget "mexuz" (Managed; hostnames mexuzsystem.com, erp-3yft.vercel.app). Set by the owner in Vercel.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY: the widget's site key, public (shown to the browser; inlined at build time, so redeploy after
# setting it). TURNSTILE_SECRET_KEY: the widget's secret key, server only, never NEXT_PUBLIC_; read only by
# src/features/auth/turnstile-server.ts (lint refuses the name elsewhere), which checks every token with Cloudflare's
# siteverify before the Supabase Auth call (with SUPABASE_SECRET_KEY, Auth skips its own CAPTCHA; keep Supabase's CAPTCHA
# protection OFF). Without BOTH: no widget and no check, the forms work as before.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Push notifications (Web Push). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# The public key goes to the browser; the private key is secret.
# PUSH_DISPATCH_SECRET: a long random string. The database sends it when it wakes
# /api/push/dispatch; put the same value in app.settings (key push_dispatch_secret).
# NEXT_PUBLIC_SITE_URL must also be set (https) for push to work.
# Without these, the app works and the phone-notifications switch says it is not set up.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_DISPATCH_SECRET=

# Background jobs (OPS-04): /api/jobs/run is woken by the database with PUSH_DISPATCH_SECRET
# (app.settings jobs_run_url, else derived from push_dispatch_url). MESSAGING_PROVIDER picks the
# provider for queued messages: empty = none (message jobs wait in the queue); "fake" = sends
# nothing, local and tests only (refused on a Vercel production or preview deployment). No real provider yet.
# MSG-01: MESSAGING_PROVIDER_EMAIL / _SMS / _WHATSAPP pick one channel's provider and win over
# MESSAGING_PROVIDER; a channel with no provider does not send.
MESSAGING_PROVIDER=
MESSAGING_PROVIDER_EMAIL=
MESSAGING_PROVIDER_SMS=
MESSAGING_PROVIDER_WHATSAPP=
# SMS-01: the platform's SMS account of the provider the owner chooses (stubs only, never chosen until built):
# MESSAGING_PROVIDER_SMS=inforu needs INFORU_USERNAME, INFORU_API_TOKEN (default sender INFORU_SENDER);
# MESSAGING_PROVIDER_SMS=sms4free needs SMS4FREE_KEY, SMS4FREE_USER, SMS4FREE_PASS (default sender SMS4FREE_SENDER).
# Each business may set its own sender name in the sending settings.
INFORU_USERNAME=
INFORU_API_TOKEN=
INFORU_SENDER=
SMS4FREE_KEY=
SMS4FREE_USER=
SMS4FREE_PASS=
SMS4FREE_SENDER=

# IMP-04 (owner (155) א, (160) א): background imports and the full export run with the rights of the person who
# ordered them. Before EVERY signing the worker asks public.background_job_token(), which checks the person again
# (active member, the right, the ordering session still open) and logs the signing in app.platform_log; it then signs
# a 10-minute token with the person's id, the ORIGINAL session's aal and id, and crm_background (recorded by the audit).
# SUPABASE_JWT_SECRET is the project's JWT secret (Supabase -> Settings -> API). It is as powerful as the service key:
# set by the owner in Vercel only, server only, never NEXT_PUBLIC_, read by src/features/background/user-token.ts and
# nowhere else (lint). Empty: the background option is not offered and such jobs wait in the queue.
SUPABASE_JWT_SECRET=

# Provider secrets (INT-02, owner 26 October 2026): connection secrets (a Meta page token, later
# provider API keys) are encrypted on the server with AES-256-GCM and the database keeps only the
# ciphertext. PROVIDER_SECRETS_KEY: 32 random bytes as base64, e.g. `openssl rand -base64 32`; set it
# in Vercel (Production and Preview). PROVIDER_SECRETS_KEY_VERSION: a whole number, 1 by default.
# Without the key no secret is stored (never a plain one). Replacing the key (owner (146) ג, the
# procedure in docs/DECISIONS.md): set the new key and version, move the old ones to
# PROVIDER_SECRETS_KEY_PREVIOUS / _PREVIOUS_VERSION (stored secrets stay readable), re-encrypt every
# stored secret with a script approved then, check the counts, and only then remove the old key.
PROVIDER_SECRETS_KEY=
PROVIDER_SECRETS_KEY_VERSION=
PROVIDER_SECRETS_KEY_PREVIOUS=
PROVIDER_SECRETS_KEY_PREVIOUS_VERSION=

# Meta (Facebook / Instagram) Lead Ads (CAP-11, owner 4 November 2026, answer (126) א).
# META_APP_SECRET: the Meta app's App Secret; every webhook POST is checked against it
#   (X-Hub-Signature-256) before the database is touched. Empty: the webhook answers 503.
# META_VERIFY_TOKEN: a long random string you also type in the app's webhook settings; the
#   GET verification answers only when it matches. Empty: 503.
# META_APP_ID: the app's id (for the page connect flow; not used yet).
# META_LEADS_PROVIDER: the Graph API adapter. Empty = none (lead ids are recorded and wait);
#   "fake" = invented answers, no network, local and tests only (refused on a Vercel production
#   or preview deployment). No real adapter yet. The page token is stored encrypted (INT-02).
# The sweep (/api/meta/leads/sweep) is woken by the database with PUSH_DISPATCH_SECRET
# (app.settings meta_leads_sweep_url, else derived from push_dispatch_url).
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_LEADS_PROVIDER=
