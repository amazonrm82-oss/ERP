# Supabase project (Settings -> API). Both values are public: the anon/publishable
# key is safe in the browser because Row Level Security enforces access.
# NEXT_PUBLIC_* values are inlined at build time, so set them before `next build`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Public origin of the app, used for email confirmation links.
# Falls back to the request origin when empty. Example: https://app.example.co.il
NEXT_PUBLIC_SITE_URL=
